# Application Environment
NODE_ENV=development
PORT=3000

# Neon PostgreSQL Connection URL (pooled endpoint recommended for serverless)
# Format: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_sample_pass@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# MCP Transport Configuration
# Supported values: streamable-http, stdio
MCP_TRANSPORT=streamable-http

# Security & Authentication
# Bearer token or secret key required in the Authorization header for /mcp requests
AUTH_SECRET=dev_secret_change_in_production_mcp_key_2026

# Optional: Default user ID for unauthenticated or test requests
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001

# Class1 Real Cost-Risk Engine Configuration
# Path to Python interpreter with class1 installed (defaults to .venv/Scripts/python.exe on Windows or .venv/bin/python)
CLASS1_PYTHON_PATH=.venv/Scripts/python.exe
# Engine execution timeout in milliseconds (default: 30000 ms = 30s)
CLASS1_TIMEOUT_MS=30000
# Budget warning threshold fraction (P90 >= WARN_FRACTION * budget => WARN; default: 0.8)
CLASS1_WARN_FRACTION=0.8
# Default Monte Carlo simulation sample count (clamped between 1,000 and 120,000; default: 10000)
CLASS1_MC_SAMPLES=10000
# Maximum concurrent engine child processes allowed (default: 2)
CLASS1_MAX_CONCURRENCY=2
# Output size cap for child process stdout in bytes (default: 5242880 = 5 MB)
CLASS1_MAX_OUTPUT_BYTES=5242880

