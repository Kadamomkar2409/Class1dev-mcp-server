{
  "name": "class1-neon-mcp-server",
  "version": "1.0.0",
  "description": "Class1Dev Production MCP Server powered by NitroStack TS SDK and Neon PostgreSQL",
  "type": "module",
  "scripts": {
    "dev": "nitrostack-cli dev",
    "build": "nitrostack-cli build",
    "start": "npm run build && node dist/index.js",
    "start:prod": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "class1dev",
    "nitrostack",
    "mcp",
    "neon",
    "postgresql",
    "chatgpt",
    "nitrocloud"
  ],
  "author": "NitroStack & Class1Dev Engineering",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@nitrostack/core": "^1.1.2",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nitrostack/cli": "^1.1.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/ws": "^8.5.14",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
